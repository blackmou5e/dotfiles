term = xterm-256color
font-size = 15
mouse-hide-while-typing = true
cursor-click-to-move = false
window-decoration = true
macos-option-as-alt = true
background-opacity = 1
background-blur-radius = 20
#macos-titlebar-style = hidden

background = 000000
foreground = b3b3b3
palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#a6adc8
palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#f5c2e7
palette = 14=#94e2d5
palette = 15=#bac2de
cursor-color = f5e0dc
cursor-text = 11111b
selection-background = 353749
selection-foreground = cdd6f4
split-divider-color = 313244
font-family = Hurmit Nerd Font Mono
font-family-bold = Hurmit Nerd Font Mono
font-family-italic = Hurmit Nerd Font Mono
font-family-bold-italic = Hurmit Nerd Font Mono

clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard

keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+j=goto_split:down
keybind = performable:ctrl+k=goto_split:up
keybind = performable:ctrl+l=goto_split:right

keybind = super+ctrl+alt+shift+h=resize_split:left,10
keybind = super+ctrl+alt+shift+j=resize_split:down,10
keybind = super+ctrl+alt+shift+k=resize_split:up,10
keybind = super+ctrl+alt+shift+l=resize_split:right,10
